{
  "$comment": "This distribution's layering, enforced by core/scripts/check-architecture.mjs at build and test time. The core's own layers are checked in boardlab-core; here its files are mapped in (aliases) so modules use only what they may. Modules import only core, shared and the modules they declare.",
  "roots": [
    "src",
    "frontends"
  ],
  "aliases": {
    "boardlab-core/": "core/src/"
  },
  "layers": {
    "shared": {
      "path": "core/src/shared",
      "may": []
    },
    "core": {
      "path": "core/src/core",
      "may": [
        "shared"
      ],
      "typeOnly": [
        "shared"
      ]
    },
    "server": {
      "path": "core/src/server",
      "may": [
        "core",
        "shared"
      ]
    },
    "cli": {
      "path": "core/src/cli",
      "may": [
        "shared"
      ]
    },
    "modules": {
      "path": "src/modules",
      "may": [
        "core",
        "shared"
      ]
    },
    "module-catalog": {
      "paths": [
        "src/modules/*/catalog.ts"
      ],
      "may": [
        "modules",
        "core",
        "shared",
        "server"
      ],
      "$comment": "a module's catalog entry: how boardd makes it from its settings"
    },
    "module-ui": {
      "paths": [
        "src/modules/*/ui.ts"
      ],
      "may": [
        "shared",
        "ui-contract"
      ],
      "typeOnly": [
        "shared"
      ],
      "node": false,
      "packages": [],
      "$comment": "a module's views (src/ui/contract.ts): data and operations, no drawing, no frontend"
    },
    "module-cli": {
      "paths": [
        "src/modules/*/cli.ts"
      ],
      "may": [
        "shared",
        "cli"
      ],
      "$comment": "a module's commands for the boardlab CLI: client code, beside the module but never using its server side"
    },
    "entry": {
      "paths": [
        "src/boardlab.ts",
        "src/catalog.ts",
        "src/commands.ts"
      ],
      "may": [
        "cli",
        "module-cli",
        "module-catalog",
        "server"
      ],
      "$comment": "the CLI entry and the registries scripts/modules.mjs writes"
    },
    "ui-contract": {
      "path": "src/ui",
      "may": [
        "shared"
      ],
      "typeOnly": [
        "shared"
      ],
      "node": false,
      "$comment": "the layer between modules and frontends: the view contract, the browser API client, and what every frontend shares (logs, notifications, the serial console, formatting)",
      "packages": [
        "react",
        "@xterm/xterm",
        "@xterm/addon-fit"
      ]
    },
    "frontends": {
      "path": "frontends",
      "may": [
        "shared",
        "ui-contract",
        "page-registry"
      ],
      "typeOnly": [
        "shared"
      ],
      "node": false,
      "packages": [
        "react",
        "react-dom",
        "@xterm/xterm",
        "@xterm/addon-fit",
        "antd",
        "@ant-design/icons",
        "dayjs"
      ],
      "$comment": "each frontend is a whole page of its own; it renders the modules' views and knows no module's internals"
    },
    "page-registry": {
      "paths": [
        "src/uis.ts"
      ],
      "may": [
        "module-ui",
        "ui-contract"
      ],
      "node": false,
      "$comment": "the registry scripts/modules.mjs writes of the modules' views"
    }
  },
  "modules": {
    "libraries": {
      "serial-mux": "the serial-mux protocol and daemons"
    },
    "dependencies": {
      "local": [
        "serial-mux"
      ],
      "home-assistant": [
        "local"
      ],
      "script-slots": [
        "local"
      ],
      "bsp": [
        "serial-mux"
      ],
      "serial-mux": [],
      "boardlab": [],
      "terminal": []
    }
  },
  "maxLines": 800
}
