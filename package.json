{
  "name": "boardlab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "boards": "dist/cli.js"
  },
  "exports": {
    "./client": {
      "types": "./core/src/shared/client.ts",
      "default": "./dist/client.js"
    },
    "./types": {
      "types": "./core/src/shared/types.ts"
    }
  },
  "scripts": {
    "modules": "node scripts/modules.mjs",
    "build": "node scripts/modules.mjs --check && node core/scripts/check-architecture.mjs && node core/scripts/build.mjs --cli src/boardlab.ts && node scripts/frontends.mjs",
    "check": "node scripts/modules.mjs --check && node core/scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "frontends": "node scripts/frontends.mjs"
  },
  "devDependencies": {
    "@ant-design/icons": "5.6.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "antd": "5.29.3",
    "dayjs": "1.11.13",
    "esbuild": "0.27.7",
    "jsdom": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "boardlab-core": "workspace:*",
    "yaml": "2.9.1"
  }
}
