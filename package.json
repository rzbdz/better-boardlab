{
  "name": "boardlab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": { "node": ">=24" },
  "bin": { "boards": "dist/cli.js" },
